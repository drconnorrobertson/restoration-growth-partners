---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import EmergencyCTABand from '../components/EmergencyCTABand.astro';
import IntroSection from '../components/IntroSection.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import DifferentiatorVS from '../components/DifferentiatorVS.astro';
import ProcessSection from '../components/ProcessSection.astro';
import FAQSection from '../components/FAQSection.astro';
import { site } from '../data/site';
const services = [
{title:'Restoration SEO',description:'Build visibility for the services and markets that matter to your restoration company.',url:'/services/restoration-seo/',chips:['Organic search']},
{title:'Google Business Profile',description:'Bring your locations, local presence, and search strategy into one connected plan.',url:'/services/google-business-profile/',chips:['Local visibility']},
{title:'Paid Advertising',description:'Reach people searching for your services with campaigns built around relevant intent.',url:'/services/paid-advertising/',chips:['Paid search']},
{title:'Website Design',description:'Give prospective customers a fast, clear path from finding your company to contacting your team.',url:'/services/website-design/',chips:['Conversion']},
{title:'Reputation Management',description:'Make customer feedback part of a consistent, credible online presence.',url:'/services/reputation-management/',chips:['Trust']},
{title:'Content Marketing',description:'Answer real customer questions with useful content that supports your broader search strategy.',url:'/services/content-marketing/',chips:['Authority']},
];
---
<BaseLayout title="Restoration Marketing That Builds Your Business | RGP" description="Restoration Growth Partners connects SEO, Google Business Profile, paid advertising, and website design to help restoration companies build their own lead flow." schema={{isHomepage:true}}>
<img slot="logo" src="/rgp-logo.png" alt="Restoration Growth Partners" width="180" height="75" class="h-12 w-auto max-w-44 object-contain md:h-14" />
<Hero eyebrow="Marketing for restoration companies" h1Lines={[{text:'Build Visibility.'},{text:'Own Your'},{text:'Lead Flow.',accent:true}]} serviceList={['SEO','Local Search','Paid Ads','Websites']} trustBullets={['Restoration industry focus','A blended search approach','Connected marketing channels','Clear business priorities']} secondaryCtaLabel="Plan Your Growth" />
<EmergencyCTABand heading="Your next customer is searching. Can they find you?" support="Connect organic visibility, local search, and paid advertising around the services you want to grow." />
<IntroSection eyebrow="Restoration Growth Partners" heading="A growth partner for the business you’re building." paragraphs={["You know restoration. We focus on the marketing systems that help people find your company, understand what you offer, and take the next step.","From local search to a better website, RGP brings the channels together so your business can build lead sources it owns and reduce reliance on shared marketplaces."]} benefits={['Industry-specific strategy','Search and paid media together','Websites built for action','Content with a clear purpose']} />
<ServiceGrid eyebrow="One connected strategy" heading="Built around how customers find you." intro="Six capabilities. One goal: help your restoration business earn attention and turn it into meaningful opportunities." services={services} />
<DifferentiatorVS leftEyebrow="A familiar challenge" leftHeading="When marketing works in silos" rightHeading="Build a connected growth system" problems={[{title:'Marketplace dependence',text:'Relying on shared leads makes it harder to control your growth.'},{title:'Disconnected channels',text:'A website, ad account, and local profiles can pull in different directions.'},{title:'Unclear priorities',text:'More activity does not always tell you what to improve next.'},{title:'Generic content',text:'Broad marketing copy misses the questions restoration customers ask.'}]} answers={[{title:'Build assets you own',text:'Invest in your website, content, local presence, and customer relationships.'},{title:'Connect the customer journey',text:'Align search visibility, advertising, and conversion around your services.'},{title:'Focus on business outcomes',text:'Use qualified conversations and opportunities to guide decisions.'},{title:'Speak your industry’s language',text:'Build content around restoration services and real customer needs.'}]} />
<div id="process" class="scroll-mt-24"><ProcessSection {...site.process} /></div>
<section class="bg-white py-16 md:py-20"><div class="mx-auto grid max-w-7xl gap-8 px-4 md:px-6 lg:grid-cols-2"><div><p class="text-xs font-bold uppercase tracking-eyebrow text-accent">See the work</p><h2 class="mt-3 font-display text-4xl md:text-5xl">Turn strategy into a clearer next step.</h2></div><div class="grid gap-4 sm:grid-cols-2"><a class="rounded-md border border-border bg-surface p-6 font-bold text-ink hover:border-accent" href="/case-studies/">Explore case studies →</a><a class="rounded-md border border-border bg-surface p-6 font-bold text-ink hover:border-accent" href="/playbooks">Browse marketing playbooks →</a></div></div></section>
<FAQSection eyebrow="Before we talk" heading="Questions about working with RGP" support="Start with your goals. Build the right plan from there." faqs={[{question:'Who does RGP work with?',answer:'RGP focuses on marketing for restoration companies, including businesses offering water damage restoration, fire damage restoration, and mold remediation.'},{question:'Can you help with both SEO and paid advertising?',answer:'Yes. Our services include SEO, Google Business Profile optimization, paid advertising, website design, reputation management, and content marketing.'},{question:'Where should we start?',answer:'Book a strategy conversation to discuss your services, target markets, current marketing, and business priorities.'},{question:'Can I explore your approach first?',answer:'Visit our services, process, case studies, and resource pages to learn more before booking a conversation.'}]} />
</BaseLayout>
