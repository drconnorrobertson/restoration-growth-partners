{
  "name": "agency-restoration-starter",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node --experimental-strip-types postbuild.mjs",
    "preview": "astro preview",
    "check": "astro check && npm run validate:artifacts && npm run validate:state && npm run validate:contrast && npm run validate:spacing && npm run validate:blog-qa",
    "validate:state": "node scripts/validate-pipeline-state.mjs",
    "status": "node scripts/validate-pipeline-state.mjs --board",
    "validate:artifacts": "node scripts/validate-artifacts.mjs",
    "validate:contrast": "node scripts/validate-contrast.mjs",
    "validate:built": "node scripts/validate-built-html.mjs",
    "validate:spacing": "node scripts/validate-spacing.mjs",
    "validate:blog-qa": "node scripts/validate-blog-qa.mjs",
    "check:built": "npm run validate:spacing && npm run build && npm run validate:built && npm run test:forms && npm run test:footer && npm run test:search && npm run test:hosting && npm run test:alerts && npm run test:scripts",
    "validate:launch": "node scripts/validate-built-html.mjs dist --launch",
    "repo:setup": "bash scripts/repo-setup.sh",
    "vercel:setup": "bash scripts/vercel-setup.sh",
    "gh:workflow-check": "node scripts/check-gh-workflow-scope.mjs",
    "vercel:hook": "node scripts/vercel-hook-setup.mjs",
    "deploy:verify": "node --experimental-strip-types scripts/verify-deploy.mjs",
    "redirects:generate": "node scripts/generate-redirects.mjs",
    "favicons:generate": "node scripts/generate-favicons.mjs",
    "leadrouter:probe": "node --experimental-strip-types scripts/probe-lead-router.mjs",
    "leadrouter:setup": "node --experimental-strip-types scripts/leadrouter-setup.mjs",
    "indexnow:submit": "node --experimental-strip-types scripts/indexnow-submit.mjs",
    "search:setup": "node scripts/search-setup.mjs",
    "search:connect": "node scripts/search-connect.mjs",
    "gsc": "node --experimental-strip-types scripts/search-console.mjs",
    "bing": "node --experimental-strip-types scripts/bing-webmaster.mjs",
    "perf:check": "node scripts/perf-check.mjs",
    "blog:publish": "node --experimental-strip-types scripts/publish-due-posts.mjs",
    "blog:review": "node --experimental-strip-types scripts/blog-review.mjs",
    "test:blog": "node --experimental-strip-types --test 'tests/blog/*.test.mjs'",
    "test:forms": "node --experimental-strip-types --test 'tests/forms/*.test.mjs'",
    "test:footer": "node --test 'tests/footer/*.test.mjs'",
    "test:search": "node --experimental-strip-types --test 'tests/search/*.test.mjs'",
    "test:hosting": "node --test 'tests/hosting/*.test.mjs'",
    "test:alerts": "node --test 'tests/alerts/*.test.mjs'",
    "test:scripts": "node --test 'tests/scripts/*.test.mjs'",
    "alert": "node --experimental-strip-types scripts/site-alert.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/barlow": "^5.2.8",
    "@fontsource/barlow-condensed": "^5.2.8",
    "@iconify-json/lucide": "^1.2.130",
    "@tailwindcss/vite": "^4.0.0",
    "astro": "^7.3.6",
    "astro-icon": "^1.2.0",
    "leaflet": "^1.9.4",
    "opentype.js": "1.3.4",
    "posthog-js": "^1.436.1",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/leaflet": "^1.9.21",
    "typescript": "^5.6.0",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
