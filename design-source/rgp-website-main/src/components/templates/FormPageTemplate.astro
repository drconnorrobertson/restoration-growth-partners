---
/**
 * Careers / Partner page template (§11 — the two optional standard forms). Compact dark PageHero → two columns:
 * the page's approved copy on the left (default slot: why work here and open roles, or who the partner program is
 * for), the standard form on the right (below the copy on phones; not sticky — an application form is taller than a
 * screen). The footer band still closes the page with tap-to-call + the request form from the shared shell (§11).
 *
 * A client page uses it only when site.forms.careers / site.forms.partner is enabled (the form renders nothing
 * otherwise). Copy is the client's approved copy — never generated here.
 */
import PageHero from '../PageHero.astro';
import CareersForm from '../CareersForm.astro';
import PartnerForm from '../PartnerForm.astro';

interface Props {
  form: 'careers' | 'partner';
  heroEyebrow: string;
  h1: string;
  heroIntro?: string;
  /** Visible form card title; defaults to "Apply Now" / "Partner With Us". */
  formTitle?: string;
  /** Template previews only: show the form even while it is switched off in site.forms. */
  preview?: boolean;
}
const { form, heroEyebrow, h1, heroIntro, formTitle, preview = false } = Astro.props;
---

<PageHero eyebrow={heroEyebrow} h1={h1} intro={heroIntro} />

<div class="bg-surface">
  <div class="mx-auto grid max-w-7xl grid-cols-1 items-start gap-10 px-4 py-12 md:px-6 md:py-16 lg:grid-cols-[minmax(0,1fr)_minmax(0,500px)] lg:gap-12">
    <article class="article min-w-0">
      <slot />
    </article>
    <aside class="w-full" id={form === 'careers' ? 'apply' : 'partner-inquiry'}>
      {form === 'careers' ? <CareersForm title={formTitle} preview={preview} /> : <PartnerForm title={formTitle} preview={preview} />}
    </aside>
  </div>
</div>

<slot name="after" />

<style>
  /* Same editorial typography as InnerPageTemplate's left column (§12), for the slotted page copy. */
  .article :global(h2) { font-family: var(--font-display); font-weight: 700; font-size: 1.875rem; line-height: 1.1; color: var(--color-ink); margin-top: 2.5rem; margin-bottom: 1rem; }
  .article :global(h2:first-child) { margin-top: 0; }
  .article :global(h3) { font-family: var(--font-display); font-weight: 700; font-size: 1.375rem; color: var(--color-ink); margin-top: 2.25rem; margin-bottom: 0.75rem; padding-left: 0.875rem; border-left: 3px solid var(--color-accent); }
  .article :global(p) { color: var(--color-ink-muted); line-height: 1.75; margin-bottom: 1rem; }
  .article :global(ul) { color: var(--color-ink-muted); line-height: 1.7; margin: 0 0 1rem 1.25rem; list-style: disc; }
  .article :global(ul li) { margin-bottom: 0.375rem; padding-left: 0.25rem; }
  .article :global(a) { color: var(--color-accent); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
  .article :global(strong) { color: var(--color-ink); }
</style>
